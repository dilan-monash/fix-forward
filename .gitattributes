# Preserve the pinned third-party runtime byte-for-byte; its integrity hash is
# part of the browser-model policy, so Git must not rewrite or lint it.
vendor/transformers/ort-wasm-simd-threaded.jsep.mjs -text -whitespace
vendor/transformers/ort-wasm-simd-threaded.jsep.wasm -text -diff
model/appliance-siglip/upstream/**/onnx/*.onnx -text -diff

# JSON processor settings and the JS bundle are also hash-pinned assets.
# Windows newline conversion would make Flask reject otherwise identical files.
vendor/transformers/transformers.min.js -text -whitespace
model/appliance-siglip/upstream/**/*.json -text
model/appliance-siglip/text-embeddings.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
