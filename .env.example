# Copy this file to .env for local development. Never commit or paste the real value in chat.
# Use the application's SELECT-only role, never an owner/admin/import credential.
# After saving, restart Flask and run: python -m backend.check_database
DATABASE_URL=postgresql://READ_ONLY_USER:PASSWORD@HOST/neondb?sslmode=require
RELEASE_VERSION=iteration-2-v2.0.0-cost-comparison
DB_CONNECT_TIMEOUT=5
# Keep "local" unless DATABASE_URL points at the isolated Iteration 2 Neon branch
# and migrations 003/004 plus the reviewed catalogue import have succeeded there.
PRICE_CATALOGUE_STORAGE=local

# Required server-side visitor access settings. Set these privately in .env/Render.
SITE_PASSWORD=
# Generate once: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Keep true on HTTPS hosting; set false only for local http://127.0.0.1:5000.
SESSION_COOKIE_SECURE=true
